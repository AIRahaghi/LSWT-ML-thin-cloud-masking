{
  "train_csv": "data/df_train_all.csv",
  "test_csv": "data/df_test_all.csv",
  "output_dir": "models/general",
  "label_column": "lst_class",
  "drop_columns": [
    "lakeN",
    "lst_raw",
    "lst_filt",
    "raamap",
    "vzamap",
    "szamap"
  ],
  "random_state": 42,
  "cv_splits": 5,
  "scoring": "balanced_accuracy",
  "group_column": "scene_id",
  "use_grouped_cv": true,
  "xgb_sample_weight": "balanced",
  "n_trials_dt": 80,
  "n_trials_rf": 120,
  "n_trials_xgb": 120,
  "optuna_n_jobs": 1
}
